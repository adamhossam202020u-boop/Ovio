<script>
  // Navigation Smooth Scroll
  const buttons = document.querySelectorAll('#catnav button');
  const sections = Array.from(buttons).map(b => document.getElementById(b.dataset.target));

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const el = document.getElementById(btn.dataset.target);
      const y = el.getBoundingClientRect().top + window.scrollY - 58;
      window.scrollTo({top: y, behavior: 'smooth'});
    });
  });

  const setActive = (id) => {
    buttons.forEach(b => b.classList.toggle('active', b.dataset.target === id));
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) setActive(entry.target.id); });
  }, { rootMargin: '-30% 0px -60% 0px', threshold: 0 });

  sections.forEach(s => s && observer.observe(s));

  // Cart & WhatsApp System
  const RESTAURANT_PHONE = "201022231095";
  let cart = {};

  function updateQty(id, name, price, change) {
    if (!cart[id]) {
      cart[id] = { name: name, price: price, qty: 0 };
    }

    cart[id].qty += change;

    if (cart[id].qty <= 0) {
      delete cart[id];
      document.getElementById(`qty-${id}`).innerText = 0;
    } else {
      document.getElementById(`qty-${id}`).innerText = cart[id].qty;
    }

    renderCartBar();
  }

  function renderCartBar() {
    let totalItems = 0;
    let totalPrice = 0;

    for (let id in cart) {
      totalItems += cart[id].qty;
      totalPrice += cart[id].qty * cart[id].price;
    }

    const countElem = document.getElementById('cartCount');
    const totalElem = document.getElementById('cartTotalText');

    if (totalItems > 0) {
      countElem.innerText = `${totalItems} أطباق`;
      totalElem.innerText = `الإجمالي: ${totalPrice} EGP`;
    } else {
      countElem.innerText = `0 أطباق`;
      totalElem.innerText = `السلة فارغة`;
    }
  }

  function sendWhatsAppOrder() {
    const cartKeys = Object.keys(cart);
    if (cartKeys.length === 0) {
      alert('السلة فارغة! برجاء اختيار بعض الأطباق بالضغط على (+) أولاً.');
      return;
    }

    let message = "مرحباً مطعم أوفيو المعادي 👋\nأود طلب الآتي من المنيو الذكي:\n\n";
    let totalPrice = 0;

    cartKeys.forEach(id => {
      const item = cart[id];
      const itemTotal = item.qty * item.price;
      totalPrice += itemTotal;
      message += `• ${item.name}\n  الكمية: ${item.qty} × ${item.price} = ${itemTotal} EGP\n\n`;
    });

    message += `------------------------------\n`;
    message += `💰 إجمالي الحساب: ${totalPrice} EGP`;

    const encodedMessage = encodeURIComponent(message);
    const whatsappUrl = `https://wa.me/${RESTAURANT_PHONE}?text=${encodedMessage}`;
    
    window.open(whatsappUrl, '_blank');
  }
</script>

