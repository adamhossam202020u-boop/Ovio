<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Ovio Maadi | Digital Menu</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Karla:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --flour:#F6F1E8;
    --paper:#FFFDF8;
    --ink:#2C2822;
    --ink-soft:#6B6255;
    --wine:#6E2A3D;
    --wine-deep:#4E1D2C;
    --sage:#71805F;
    --amber:#C9942F;
    --line: rgba(44,40,34,0.13);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--flour);
    color:var(--ink);
    font-family:'Karla', 'Alexandria', sans-serif;
    -webkit-font-smoothing:antialiased;
    padding-bottom: 90px;
  }
  ::selection{ background:var(--amber); color:#fff; }

  .browserbar{
    background:#2C2822;
    color:#c9c0b2;
    font-size:12px;
    display:flex;
    align-items:center;
    gap:8px;
    padding:9px 14px;
  }
  .browserbar .dots{display:flex; gap:5px;}
  .browserbar .dots span{width:8px;height:8px;border-radius:50%;background:#5a5347;display:inline-block;}
  .browserbar .url{
    flex:1;
    background:rgba(255,255,255,0.06);
    border-radius:20px;
    padding:5px 12px;
    display:flex;
    align-items:center;
    gap:6px;
    justify-content:center;
    color:#EDE6D8;
    letter-spacing:0.2px;
  }
  .browserbar .url svg{width:11px;height:11px;flex-shrink:0;}

  .pattern{
    height:10px;
    background: repeating-linear-gradient(90deg, var(--amber) 0 22px, var(--sage) 22px 44px);
    opacity:0.85;
  }

  .hero{
    background: radial-gradient(120% 100% at 50% -10%, #5c2333 0%, var(--wine-deep) 55%, #35141c 100%);
    color:#F3E9DB;
    padding:40px 22px 32px;
    text-align:center;
    position:relative;
    overflow:hidden;
  }
  .hero::before, .hero::after{
    content:"";
    position:absolute;
    border:1px solid rgba(243,233,219,0.14);
    border-radius:50%;
  }
  .hero::before{ width:240px; height:240px; right:-100px; top:-120px; }
  .hero::after{ width:200px; height:200px; left:-100px; bottom:-130px; }

  .badge{
    display:inline-block;
    font-size:11.5px;
    color:#F3E9DB;
    background:rgba(255,255,255,0.12);
    border:1px solid rgba(255,255,255,0.25);
    padding:4px 14px;
    border-radius:20px;
    margin-bottom:18px;
    letter-spacing:0.4px;
    text-transform:uppercase;
  }

  .hero-art{ width:130px; height:80px; margin:0 auto 18px; position:relative; z-index:1; }
  .hero-art svg{ width:100%; height:100%; }

  .hero h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:48px;
    margin:0 0 6px;
    letter-spacing:0.5px;
    position:relative;
  }
  .hero p.tag{
    margin:0 0 22px;
    font-size:14.5px;
    color:#E3D4C4;
    font-weight:300;
    letter-spacing:0.4px;
    text-transform:uppercase;
  }
  .hero .meta{
    display:flex;
    justify-content:center;
    gap:20px;
    flex-wrap:wrap;
    font-size:12.5px;
    color:#F3E9DB;
    position:relative;
  }
  .hero .meta span{ display:flex; align-items:center; gap:5px; opacity:0.92; }
  .hero .meta svg{width:13px;height:13px;}

  .catnav-wrap{
    position:sticky;
    top:0;
    z-index:20;
    background:var(--flour);
    border-bottom:1px solid var(--line);
    box-shadow:0 6px 14px -10px rgba(44,40,34,0.35);
  }
  .catnav{
    display:flex;
    gap:8px;
    overflow-x:auto;
    padding:12px 16px;
    scrollbar-width:none;
  }
  .catnav::-webkit-scrollbar{display:none;}
  .catnav button{
    flex:none;
    font-family:'Karla', 'Alexandria', sans-serif;
    font-size:13px;
    font-weight:600;
    letter-spacing:0.2px;
    color:var(--ink-soft);
    background:var(--paper);
    border:1px solid var(--line);
    padding:8px 16px;
    border-radius:20px;
    cursor:pointer;
    transition:background .2s, color .2s, border-color .2s;
    white-space:nowrap;
    text-transform:uppercase;
  }
  .catnav button.active{
    background:var(--wine);
    border-color:var(--wine);
    color:#fbf3e8;
  }

  main{ max-width:640px; margin:0 auto; padding:6px 20px 40px; }
  section.cat{ padding-top:30px; scroll-margin-top:64px; }

  .head{ display:flex; align-items:center; gap:14px; margin-bottom:4px; }
  .head .titles{ flex:1; min-width:0; }
  .cat-art{
    width:56px; height:56px; flex:none;
    display:flex; align-items:center; justify-content:center;
    background:var(--paper); border:1px solid var(--line);
    border-radius:50%; padding:12px;
  }
  .cat-art svg{ width:100%; height:100%; }

  section.cat h2{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:25px;
    color:var(--wine-deep);
    margin:0 0 2px;
  }
  section.cat .subtitle{
    font-size:12.5px;
    color:var(--ink-soft);
    margin:0;
    font-weight:400;
  }
  .rule{
    height:1px;
    background:repeating-linear-gradient(90deg, var(--amber) 0 6px, transparent 6px 11px);
    opacity:0.8;
    margin:12px 0 18px;
  }

  .item{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    padding:14px 0;
    border-bottom:1px solid var(--line);
  }
  .item:last-child{ border-bottom:none; }
  .item .item-img{
    width:70px;
    height:70px;
    border-radius:12px;
    object-fit:cover;
    flex-shrink:0;
    border:1px solid var(--line);
  }
  .item .info{ flex:1; min-width:0; }
  .item .name{
    font-family:'Fraunces', serif;
    font-size:16.5px;
    font-weight:600;
    color:var(--ink);
    margin:0 0 3px;
  }
  .item .desc{
    font-size:12.5px;
    color:var(--ink-soft);
    font-weight:400;
    line-height:1.5;
    margin:0;
  }
  .ar-title{
    font-family:'Alexandria', sans-serif;
    font-size:13.5px;
    color:var(--wine);
    margin-left:6px;
    font-weight:500;
  }
  .ar-desc{
    font-family:'Alexandria', sans-serif;
    font-size:11.5px;
    color:var(--ink-soft);
    display:block;
    margin-top:2px;
  }
  .item-action{
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:8px;
    flex-shrink:0;
  }
  .item .price{
    font-family:'Karla',sans-serif;
    font-weight:700;
    font-size:15px;
    color:var(--wine);
    white-space:nowrap;
  }
  .item .price::after{ content:" EGP"; font-weight:500; font-size:10.5px; color:var(--ink-soft); }

  /* Cart Controls */
  .qty-controls{
    display:flex;
    align-items:center;
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:20px;
    padding:2px 6px;
    gap:8px;
  }
  .qty-btn{
    background:none;
    border:none;
    color:var(--wine);
    font-weight:700;
    font-size:16px;
    cursor:pointer;
    width:22px;
    height:22px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
  }
  .qty-btn:active{ background:rgba(110,42,61,0.1); }
  .qty-count{
    font-weight:700;
    font-size:13px;
    color:var(--ink);
    min-width:14px;
    text-align:center;
  }

  .tagline-strip{
    margin:34px 0 6px;
    text-align:center;
    padding:18px 14px;
    background:var(--paper);
    border:1px dashed var(--line);
    border-radius:14px;
    font-size:12.5px;
    color:var(--ink-soft);
  }
  .tagline-strip b{ color:var(--sage); }

  footer{
    background:var(--ink);
    color:#D9D0C1;
    padding:34px 22px 26px;
    text-align:center;
  }
  footer h3{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:24px;
    color:#F3E9DB;
    margin:0 0 8px;
  }
  footer p{ font-size:12.5px; color:#B7AC98; margin:0 0 18px; line-height:1.7;}
  .foot-links{ display:flex; justify-content:center; gap:10px; flex-wrap:wrap; }
  .foot-links a{
    display:inline-flex; align-items:center; gap:6px;
    font-size:12.5px; color:#F3E9DB; text-decoration:none;
    border:1px solid rgba(243,233,219,0.25);
    padding:8px 16px; border-radius:20px;
  }
  .foot-links a svg{width:13px;height:13px;}
  .demo-note{
    margin-top:22px; font-size:11px; color:#8c8272;
    border-top:1px solid rgba(217,208,193,0.15);
    padding-top:14px;
  }

  /* Cart FAB & WhatsApp Bar */
  .cart-bar{
    position:fixed; bottom:18px; left:50%; transform:translateX(-50%);
    width:calc(100% - 36px); max-width:500px;
    background:var(--sage); color:#F3E9DB;
    border:none; border-radius:30px;
    padding:12px 20px;
    font-family:'Alexandria', 'Karla', sans-serif; font-weight:600; font-size:13.5px;
    display:flex; align-items:center; justify-content:space-between;
    box-shadow:0 8px 24px -4px rgba(0,0,0,0.45);
    cursor:pointer; z-index:30;
    transition: transform 0.2s, background-color 0.2s;
  }
  .cart-bar:hover{ background:#5f6d4f; }
  .cart-bar:active{ transform:translateX(-50%) scale(0.98); }
  .cart-info{ display:flex; align-items:center; gap:10px; }
  .cart-badge{
    background:#25D366; color:#ffffff;
    font-weight:700; font-size:12px;
    padding:3px 10px; border-radius:14px;
  }

  @media (prefers-reduced-motion: reduce){ html{ scroll-behavior:auto; } }
</style>
</head>
<body>

  <div class="browserbar">
    <div class="dots"><span></span><span></span><span></span></div>
    <div class="url">
      <svg viewBox="0 0 24 24" fill="none" stroke="#c9c0b2" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
      oviomaadi.com
    </div>
  </div>
  <div class="pattern"></div>

  <div class="hero">
    <span class="badge">Demo Preview · معاينة تجريبية</span>
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 220 130" fill="none">
        <ellipse cx="110" cy="115" rx="90" ry="8" fill="#F3E9DB" opacity="0.12"/>
        <path d="M50 95c0-32 18-58 60-58s60 26 60 58" stroke="#E3B65C" stroke-width="3" stroke-linecap="round"/>
        <path d="M50 95h120" stroke="#E3B65C" stroke-width="3" stroke-linecap="round"/>
        <path d="M78 60c8-6 18-8 32-8s24 2 32 8" stroke="#F3E9DB" stroke-width="2" opacity="0.55" stroke-linecap="round"/>
        <circle cx="94" cy="45" r="3" fill="#E3B65C"/>
        <circle cx="126" cy="42" r="3" fill="#F3E9DB" opacity="0.8"/>
        <circle cx="110" cy="52" r="3" fill="#E3B65C"/>
      </svg>
    </div>
    <h1>Ovio</h1>
    <p class="tag">Modern European Kitchen &amp; Bakery <br><span style="font-size:12.5px; opacity:0.85; text-transform:none;">مطبخ ومخبز أوروبي عصري</span></p>
    <div class="meta">
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="#F3E9DB" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        Daily · 8:00 AM – 12:00 AM · يومياً
      </span>
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="#F3E9DB" stroke-width="2"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
        Street 18, Maadi Sarayat · المعادي
      </span>
    </div>
  </div>

  <div class="catnav-wrap">
    <div class="catnav" id="catnav">
      <button data-target="bakery" class="active">Bakery · مخبوزات</button>
      <button data-target="brunch">Brunch · إفطار</button>
      <button data-target="pizza">Pizza · بيتزا</button>
      <button data-target="pasta">Pasta · باستا</button>
      <button data-target="mains">Mains · أطباق رئيسية</button>
    </div>
  </div>

  <main>

    <section class="cat" id="bakery">
      <div class="head">
        <div class="cat-art">
          <svg viewBox="0 0 48 48" fill="none">
            <path d="M8 26c0-9 7-16 16-16s16 7 16 16-7 10-16 10-16-1-16-10z" stroke="#6E2A3D" stroke-width="2.5" stroke-linejoin="round"/>
            <path d="M16 20c1.5 2 1.5 5 0 7M24 17c1.5 2 1.5 6 0 8M32 20c1.5 2 1.5 5 0 7" stroke="#C9942F" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="titles">
          <h2>Artisan Bakery <span class="ar-title">المخبوزات الحرفية</span></h2>
          <p class="subtitle">Baked fresh in-house, every morning · يُخبز طازجاً كل صباح</p>
        </div>
      </div>
      <div class="rule"></div>

      <div class="item">
        <img class="item-img" src="https://images.unsplash.com/photo-1586444248902-2f64eddc13df?w=200&q=80" alt="Sourdough Loaf">
        <div class="info">
          <p class="name">Sourdough Loaf <span class="ar-title">خبز الصوردو</span></p>
          <p class="desc">48-hour fermented, crisp crust, open crumb <span class="ar-desc">مخمر لمدة 48 ساعة، قشرة مقرمشة وطرية من الداخل</span></p>
        </div>
        <div class="item-action">
          <div class="price">120</div>
          <div class="qty-controls">
            <button class="qty-btn" onclick="updateQty('sourdough', 'Sourdough Loaf (خبز الصوردو)', 120, -1)">-</button>
            <span class="qty-count" id="qty-sourdough">0</span>
            <button class="qty-btn" onclick="updateQty('sourdough', 'Sourdough Loaf (خبز الصوردو)', 120, 1)">+</button>
          </div>
        </div>
      </div>

      <div class="item">
        <img class="item-img" src="https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=200&q=80" alt="Butter Croissant">
        <div class="info">
          <p class="name">Butter Croissant <span class="ar-title">كرواسون بالزبدة</span></p>
          <p class="desc">Laminated French-style, baked to order <span class="ar-desc">على الطريقة الفرنسية بالزبدة الفاخرة، يخبز عند الطلب</span></p>
        </div>
        <div class="item-action">
          <div class="price">65</div>
          <div class="qty-controls">
            <button class="qty-btn" onclick="updateQty('croissant', 'Butter Croissant (كرواسون زبدة)', 65, -1)">-</button>
            <span class="qty-count" id="qty-croissant">0</span>
            <button class="qty-btn" onclick="updateQty('croissant', 'Butter Croissant (كرواسون زبدة)', 65, 1)">+</button>
          </div>
        </div>
      </div>

      <div class="item">
        <img class="item-img" src="https://images.unsplash.com/photo-1608198093002-ad4e005484ec?w=200&q=80" alt="Pain au Chocolat">
        <div class="info">
          <p class="name">Pain au Chocolat <span class="ar-title">بان أو شوكولا</span></p>
          <p class="desc">Dark chocolate batons in buttery layers <span class="ar-desc">قطع الشوكولاتة الداكنة داخل طبقات الكرواسون الهشة</span></p>
        </div>
        <div class="item-action">
          <div class="price">75</div>
          <div class="qty-controls">
            <button class="qty-btn" onclick="updateQty('pain-choc', 'Pain au Chocolat (بان أو شوكولا)', 75, -1)">-</button>
            <span class="qty-count" id="qty-pain-choc">0</span>
            <button class="qty-btn" onclick="updateQty('pain-choc', 'Pain au Chocolat (بان أو شوكولا)', 75, 1)">+</button>
          </div>
        </div>
      </div>

      <div class="item">
        <img class="item-img" src="https://images.unsplash.com/photo-1509440159596-0249088772ff?w=200&q=80" alt="Cinnamon Roll">
        <div class="info">
          <p class="name">Cinnamon Roll <span class="ar-title">سينامون رول</span></p>
          <p class="desc">Cream cheese glaze, served warm <span class="ar-desc">مع صوص الجبنة الكريمية الغني، يُقدم دافئاً</span></p>
        </div>
        <div class="item-action">
          <div class="price">80</div>
          <div class="qty-controls">
            <button class="qty-btn" onclick="updateQty('cinnamon', 'Cinnamon Roll (سينامون رول)', 80, -1)">-</button>
            <span class="qty-count" id="qty-cinnamon">0</span>
            <button class="qty-btn" onclick="updateQty('cinnamon', 'Cinnamon Roll (سينامون رول)', 80, 1)">+</button>
          </div>
        </div>
      </div>
    </section>

    <section class="cat" id="brunch">
      <div class="head">
        <div class="cat-art">
          <svg viewBox="0 0 48 48" fill="none">
            <ellipse cx="24" cy="34" rx="16" ry="4" fill="#C9942F" opacity="0.2"/>
            <path d="M10 20a14 14 0 0 0 28 0" stroke="#6E2A3D" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M14 12c1-3 3-3 4 0M22 10c1-3 3-3 4 0M30 12c1-3 3-3 4 0" stroke="#71805F" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="titles">
          <h2>Breakfast &amp; Brunch <span class="ar-title">الإفطار والبرانش</span></h2>
          <p class="subtitle">Cairo's favourite brunch table, all day · وجبات الإفطار طوال اليوم</p>
        </div>
      </div>
      <div class="rule"></div>

      <div class="item">
        <img class="item-img" src="https://images.unsplash.com/photo-1567620905732-2d1ec7ab7445?w=200&q=80" alt="Belgian Chocolate Pancakes">
        <div class="info">
          <p class="name">Belgian Pancakes <span class="ar-title">بان كيك بلجيكي</span></p>
          <p class="desc">Stacked pancakes, warm chocolate sauce, berries <span class="ar-desc">طبقات البان كيك مع صوص الشوكولاتة الدافئ والفواكه</span></p>
        </div>
        <div class="item-action">
          <div class="price">210</div>
          <div class="qty-controls">
            <button class="qty-btn" onclick="updateQty('pancakes', 'Belgian Pancakes (بان كيك بلجيكي)', 210, -1)">-</button>
            <span class="qty-count" id="qty-pancakes">0</span>
            <button class="qty-btn" onclick="updateQty('pancakes', 'Belgian Pancakes (بان كيك بلجيكي)', 210, 1)">+</button>
          </div>
        </div>
      </div>

      <div class="item">
        <img class="item-img" src="https://images.unsplash.com/photo-1525351484163-7529414344d8?w=200&q=80" alt="Avocado Toast with Feta">
        <div class="info">
          <p class="name">Avocado Toast <span class="ar-title">توست الأفوكادو</span></p>
          <p class="desc">Sourdough, whipped feta, chili oil, radish <span class="ar-desc">خبز صوردو، جبنة فيتا مخفوقة، زيت فلفل حار، وفجل</span></p>
        </div>
        <div class="item-action">
          <div class="price">195</div>
          <div class="qty-controls">
            <button class="qty-btn" onclick="updateQty('avocado-toast', 'Avocado Toast (توست الأفوكادو)', 195, -1)">-</button>
            <span class="qty-count" id="qty-avocado-toast">0</span>
            <button class="qty-btn" onclick="updateQty('avocado-toast', 'Avocado Toast (توست الأفوكادو)', 195, 1)">+</button>
          </div>
        </div>
      </div>

      <div class="item">
        <img class="item-img" src="https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?w=200&q=80" alt="Smoked Salmon Bagel">
        <div class="info">
          <p class="name">Salmon Bagel <span class="ar-title">باجل سالمون</span></p>
          <p class="desc">Cream cheese, capers, red onion, dill <span class="ar-desc">جبنة كريمية، كابري، بصل أحمر وشبت</span></p>
        </div>
        <div class="item-action">
          <div class="price">240</div>
          <div class="qty-controls">
            <button class="qty-btn" onclick="updateQty('salmon-bagel', 'Salmon Bagel (باجل السالمون)', 240, -1)">-</button>
            <span class="qty-count" id="qty-salmon-bagel">0</span>
            <button class="qty-btn" onclick="updateQty('salmon-bagel', 'Salmon Bagel (باجل السالمون)', 240, 1)">+</button>
          </div>
        </div>
      </div>

